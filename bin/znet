#!/system/bin/sh
# znet - Zishu Network Information Tool
# Part of Zishu Terminal (com.zishu.terminal)
# License: MIT
# Copyright (c) 2025 ZISHU TRON
# Android-compatible: No awk, limited grep

set -e

# Colors
R='\033[0;31m'
G='\033[0;32m'
Y='\033[0;33m'
B='\033[0;34m'
C='\033[0;36m'
N='\033[0m'

print_header() {
    echo ""
    echo "${C}===========================================${N}"
    echo "${C}|${N}  ${G}Zishu Network Info${N}                    ${C}|${N}"
    echo "${C}===========================================${N}"
    echo ""
}

get_local_ip() {
    IP=""
    
    # Method 1: getprop
    IP=$(getprop dhcp.wlan0.ipaddress 2>/dev/null)
    
    # Method 2: ip command with simple grep
    if [ -z "$IP" ] && command -v ip >/dev/null 2>&1; then
        IP=$(ip -4 addr show wlan0 2>/dev/null | grep "inet " | cut -d' ' -f6 | cut -d'/' -f1)
    fi
    
    # Method 3: any interface
    if [ -z "$IP" ] && command -v ip >/dev/null 2>&1; then
        IP=$(ip -4 addr show 2>/dev/null | grep "inet " | grep -v "127.0.0.1" | cut -d' ' -f6 | cut -d'/' -f1 | head -1)
    fi
    
    # Method 4: ifconfig
    if [ -z "$IP" ] && command -v ifconfig >/dev/null 2>&1; then
        IP=$(ifconfig wlan0 2>/dev/null | grep "inet addr" | cut -d':' -f2 | cut -d' ' -f1)
    fi
    
    if [ -z "$IP" ]; then
        echo "unavailable"
    else
        echo "$IP"
    fi
}

get_gateway() {
    GW=""
    
    # Method 1: getprop
    GW=$(getprop dhcp.wlan0.gateway 2>/dev/null)
    
    # Method 2: ip route
    if [ -z "$GW" ] && command -v ip >/dev/null 2>&1; then
        GW=$(ip route 2>/dev/null | grep "default" | cut -d' ' -f3 | head -1)
    fi
    
    if [ -z "$GW" ]; then
        echo "unavailable"
    else
        echo "$GW"
    fi
}

get_dns() {
    DNS=""
    
    DNS=$(getprop net.dns1 2>/dev/null)
    if [ -z "$DNS" ]; then
        DNS=$(getprop dhcp.wlan0.dns1 2>/dev/null)
    fi
    
    if [ -z "$DNS" ]; then
        echo "unavailable"
    else
        echo "$DNS"
    fi
}

get_interface() {
    IF=""
    
    # Method 1: check wlan0
    if command -v ip >/dev/null 2>&1; then
        IF=$(ip link show 2>/dev/null | grep "^[0-9]" | cut -d':' -f2 | grep -v "lo" | head -1 | tr -d ' ')
    fi
    
    if [ -z "$IF" ]; then
        # Check if wlan0 exists
        if [ -d /sys/class/net/wlan0 ]; then
            IF="wlan0"
        elif [ -d /sys/class/net/eth0 ]; then
            IF="eth0"
        fi
    fi
    
    if [ -z "$IF" ]; then
        echo "unavailable"
    else
        echo "$IF"
    fi
}

get_public_ip() {
    # Try with curl
    if command -v curl >/dev/null 2>&1; then
        RESULT=$(curl -s --max-time 5 https://api.ipify.org 2>/dev/null)
        if [ -n "$RESULT" ]; then
            echo "$RESULT"
            return
        fi
    fi
    
    if command -v zcurl >/dev/null 2>&1; then
        RESULT=$(zcurl -s --max-time 5 https://api.ipify.org 2>/dev/null)
        if [ -n "$RESULT" ]; then
            echo "$RESULT"
            return
        fi
    fi
    
    echo "unavailable (curl needed)"
}

test_connectivity() {
    HOST="$1"
    NAME="$2"
    
    if command -v ping >/dev/null 2>&1; then
        if ping -c 1 -W 2 "$HOST" >/dev/null 2>&1; then
            echo "  ${G}[OK]${N} $NAME ($HOST) reachable"
        else
            echo "  ${R}[FAIL]${N} $NAME ($HOST) not reachable"
        fi
    else
        echo "  ${Y}[SKIP]${N} ping not available"
    fi
}

# Main
print_header

echo "${Y}Local Network${N}"
echo "  Interface:     $(get_interface)"
echo "  Local IP:      $(get_local_ip)"
echo "  Gateway:       $(get_gateway)"
echo ""

echo "${Y}DNS${N}"
echo "  Primary DNS:   $(get_dns)"
echo ""

echo "${Y}Public IP${N}"
echo "  Public IP:     $(get_public_ip)"
echo ""

echo "${Y}Connectivity${N}"
test_connectivity "8.8.8.8" "Google DNS"
test_connectivity "1.1.1.1" "Cloudflare DNS"
echo ""

echo "${C}===========================================${N}"
echo ""
